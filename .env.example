# Copiar este archivo a .env y completar con las credenciales reales.
# NUNCA commitear el archivo .env (ya está en .gitignore).
#
# El curso es agnóstico de proveedor (ver Clase 3: "Abstracción de proveedores").
# Alcanza con completar la sección de UN proveedor para seguir los laboratorios.
# LLM_PROVIDER le indica al código de ejemplo cuál usar.

LLM_PROVIDER=bedrock   # valores posibles: bedrock | anthropic | openai | google | ollama

# ---------------------------------------------------------------------------
# Opción 1: AWS Bedrock (gateway multi-proveedor — acceso provisto por la cátedra)
# ---------------------------------------------------------------------------
# Usá UNO de estos dos esquemas de autenticación (no hace falta completar ambos):
#
#   (a) Bearer token — API key de Bedrock generada desde la consola:
AWS_BEARER_TOKEN_BEDROCK=
#
#   (b) Par de credenciales IAM clásico (ej. el CSV que descarga la consola de AWS
#       al crear un access key para un usuario IAM):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# En ambos casos:
AWS_REGION=us-east-1
#
# Nunca uses las credenciales del usuario ROOT de la cuenta de AWS para esto —
# si te dieron un access key de ese tipo, pedí que te generen un usuario IAM
# normal con permisos acotados a Bedrock en su lugar.

# Model IDs de Bedrock (confirmados en la documentación oficial de AWS Bedrock).
# Claude Sonnet 4.6 se invoca vía inference profile, no vía model ID "pelado":
#   global.anthropic.claude-sonnet-4-6   -> cross-region global (recomendado por defecto)
#   us.anthropic.claude-sonnet-4-6       -> cross-region dentro de EEUU/Canadá
#   eu.anthropic.claude-sonnet-4-6       -> cross-region dentro de la UE
BEDROCK_MODEL_ID_CLAUDE=global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID_EMBED=cohere.embed-v4:0

# ---------------------------------------------------------------------------
# Opción 2: Anthropic API directa (sin pasar por Bedrock)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6
# Nota: Anthropic no ofrece modelo de embeddings propio; combinar con otro proveedor
# (Cohere, OpenAI, Google) para la parte de embeddings si se usa esta opción.

# ---------------------------------------------------------------------------
# Opción 3: OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-large
# Verificar el modelo vigente en la documentación de OpenAI antes de usar — la
# oferta de modelos cambia con frecuencia.

# ---------------------------------------------------------------------------
# Opción 4: Google (Gemini)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_MODEL_ID=gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL_ID=text-embedding-004
# Verificar el modelo vigente en la documentación de Google AI antes de usar.

# ---------------------------------------------------------------------------
# Opción 5: Modelos abiertos locales (Ollama) — sin costo de API, sin credenciales
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1
# No incluye modelo de embeddings dedicado de alta calidad por defecto;
# para embeddings locales, ver alternativas como nomic-embed-text vía Ollama.
